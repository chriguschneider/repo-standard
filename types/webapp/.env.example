# Copy to .env (never committed). Every secret and every host-specific
# value comes from the environment; the code has no defaults for secrets.

# Public origin of the app (scheme + host + port), used for redirects, form
# actions and absolute URLs. Set it to the address users type in.
ORIGIN=http://localhost:3000

# Where the SQLite database lives. Inside the container this is /data, a
# volume (docker-compose.yml); for `npm run dev` the default is ./data/.
# DATABASE_PATH=/data/@@DOMAIN@@.db
